{
    "name": "Vonage + Mastra AI Starter",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
    "hostRequirements": {
        "cpus": 2
    },
    "waitFor": "onCreateCommand",
    "updateContentCommand": "npm install",
    "postCreateCommand": "npm install",
    "postAttachCommand": "gh codespace ports visibility 3000:public -c $CODESPACE_NAME && node setup.js && npm start",
    "customizations": {
        "codespaces": {
            "openFiles": [
                "index.js"
            ]
        }
    },
    "portsAttributes": {
        "3000": {
            "label": "Mastra Server",
            "onAutoForward": "openPreview",
            "protocol": "http",
            "visibility": "public"
        }
    },
    "forwardPorts": [
        3000
    ],
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    }
}
